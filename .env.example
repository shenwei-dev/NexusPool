# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，切勿提交。
# 必需项：DB_PASSWORD、JWT_SECRET_KEY、AI_API_KEY、AI_BASE_URL（无默认值，缺失会导致启动失败）。

# --- MySQL ---
DB_URL=jdbc:mysql://localhost:3306/liteim?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- JWT：请填写至少 32 字节的随机字符串 ---
JWT_SECRET_KEY=

# --- AI（OpenAI 兼容接口） ---
AI_MODEL=qwen3.7-plus
AI_API_KEY=
AI_BASE_URL=

# --- S3 兼容对象存储（B2 / OSS 等） ---
OSS_ENDPOINT=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_SECRET_ACCESS_KEY=
OSS_BUCKET_NAME=

# --- Grafana（docker compose 读取；请设置强密码，留空时回退为 admin） ---
GRAFANA_ADMIN_PASSWORD=
