<?xml version="1.0" encoding="utf-8"?>
<configuration>

    <!-- 从 Spring 环境读取应用名与日志目录, 便于多应用/多环境隔离 -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="family-chat"/>
    <property name="LOG_PATH" value="logs"/>

    <!-- 控制台输出格式: 时间 [线程] 级别 [traceId] [userId] 类名 - 消息 (包含 MDC 链路/用户维度, 支持颜色高亮) -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%yellow(%d{yyyy-MM-dd HH:mm:ss.SSS}) [%thread] %highlight(%-5level) %cyan([%X{traceId:-N/A}]) %magenta([%X{userId:-}]) %green(%logger{40}) - %msg%n" />

    <!-- 文件输出格式: 不带颜色, traceId 缺失时补 N/A 便于 Grafana/Loki 正则解析对齐 -->
    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-N/A}] [%X{userId:-}] %logger{40} - %msg%n" />

    <!-- 1. 控制台 Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 2. INFO 级别文件归档 Appender -->
    <appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/chat_info.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/chat_info-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <!-- 磁盘保护: 归档文件总大小上限, 防止磁盘被打满引发故障 -->
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>DENY</onMatch>
            <onMismatch>ACCEPT</onMismatch>
        </filter>
    </appender>

    <!-- 3. ERROR 级别文件归档 Appender (独立出来便于线上报警) -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/chat_error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/chat_error-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
    </appender>

    <!-- 4. Loki 异步日志推送器 (内部自带异步批量发送机制) -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <!-- 默认本地 Loki 的 API 接收地址 -->
            <url>http://127.0.0.1:3100/loki/api/v1/push</url>
        </http>
        <format>
            <!-- 仅索引必要元数据标签, 不做全文索引, 节省存储 -->
            <label>
                <pattern>app=${APP_NAME},host=${HOSTNAME},level=%level</pattern>
            </label>
            <message>
                <!-- 真正的日志内容 (包含 traceId) -->
                <pattern>${FILE_LOG_PATTERN}</pattern>
            </message>
        </format>
    </appender>

    <!-- 5. 根日志配置 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="INFO_FILE" />
        <appender-ref ref="ERROR_FILE" />
        <appender-ref ref="LOKI" />
    </root>

</configuration>
