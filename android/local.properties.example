# 复制为 local.properties 后填写本机值；该文件已被 .gitignore 忽略，切勿提交。
# sdk.dir 通常由 Android Studio 自动生成，这里只列出项目自定义配置项。
# 真实的高德 WebKey / 声网 AppID 只写在本地 local.properties 中。

# 服务端地址：Android 模拟器访问宿主机用 10.0.2.2；真机请填局域网 IP 或域名
server.host=10.0.2.2
server.http.port=8080
server.ws.port=8081

# 第三方服务（留空时静态地图 / 音视频通话功能不可用）
amap.web.key=
agora.app.id=
