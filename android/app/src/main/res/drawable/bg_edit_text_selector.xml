<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 状态一：获得焦点时（键盘弹起，展示微信绿底线） -->
    <item android:state_focused="true">
        <layer-list>
            <!-- 通过负数 margin，只保留底部 border -->
            <item android:top="-2dp" android:left="-2dp" android:right="-2dp">
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="#07C160" /> <!-- 微信绿 -->
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- 状态二：默认未聚焦状态（展示超细淡灰底线） -->
    <item>
        <layer-list>
            <item android:top="-1dp" android:left="-1dp" android:right="-1dp">
                <shape android:shape="rectangle">
                    <stroke android:width="0.5dp" android:color="#D1D1D1" /> <!-- 细灰色 -->
                </shape>
            </item>
        </layer-list>
    </item>

</selector>