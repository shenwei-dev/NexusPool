<resources>
    <style name="Theme.FamilyChatApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 可以自定义颜色 -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="WeChatSwitchTheme">
        <!-- 开启状态下的开关滑块颜色 (微信绿) -->
        <item name="colorControlActivated">#07C160</item>
        <!-- 关闭状态下的滑块及轨道颜色 -->
        <item name="colorSwitchThumbNormal">#FFFFFF</item>
        <item name="android:colorForeground">#E0E0E0</item>
    </style>

    <!-- 去除 BottomSheet 背后黑色死角的透明主题 -->
    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- 微信底部 Tab 精致字体规范 -->
    <style name="BottomNavTextActive">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item> <!-- 去除原生笨重的加粗 -->
    </style>

    <style name="BottomNavTextInactive">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="WeChatAvatarCorner" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item> <!-- 微信标准的圆角半径为 4dp（或6dp） -->
    </style>

    <style name="UCropBlackTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">#1A1A1A</item>

        <!-- 🌟 底部系统虚拟导航栏背景色：#0D0E11 -->
        <item name="android:navigationBarColor">#0D0E11</item>

        <!-- 🌟 强制关闭系统半透明导航栏遮罩 (关键！解决 Vivo 导航栏变色问题) -->
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
