<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F7F7F7">

    <!-- 1. 顶部极简扁平导航栏 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/btn_back_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            tools:ignore="MissingConstraints">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_back"
                app:tint="#1A1A1A" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_more"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_more"
            app:tint="#1A1A1A"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. 核心信息名片卡片 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="48dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <!-- 头像 -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_avatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/sym_def_app_icon"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 昵称 (微信同款 22sp 粗体) -->
        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="A 鲜气飘飘..."
            android:textColor="#181818"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/iv_avatar"
            app:layout_constraintTop_toTopOf="@id/iv_avatar" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3. 细线与间隔 -->
    <View
        android:id="@+id/view_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#E5E5E5"
        app:layout_constraintTop_toBottomOf="@id/layout_header" />

    <View
        android:id="@+id/view_spacer"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:background="#F7F7F7"
        app:layout_constraintTop_toBottomOf="@id/view_divider" />

    <!-- 4. 底部“添加到通讯录”整行白色按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_to_contacts"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#FFFFFF"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="添加到通讯录"
        android:textColor="#576B95"
    android:textSize="16sp"
    android:textStyle="bold"
    app:rippleColor="#1A576B95"
    android:stateListAnimator="@null"
    app:layout_constraintTop_toBottomOf="@id/view_spacer" />

    <!-- 底部底线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#E5E5E5"
        app:layout_constraintTop_toBottomOf="@id/btn_add_to_contacts" />

    <!-- 剩余部分留白浅灰 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#F7F7F7"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_add_to_contacts" />

</androidx.constraintlayout.widget.ConstraintLayout>