<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:padding="8dp">

    <!-- 1. 对方的头像 (在左侧) -->
    <ImageView
        android:id="@+id/iv_receive_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/bg_icon_green_rounded" />

    <!-- 2. 消息气泡卡片 (固定宽度 230dp) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_location_bubble"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 2.1 上半部分：地址名称与路牌信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- 主地名 (如：君悦府) -->
                <TextView
                    android:id="@+id/tv_location_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#111111"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- 路牌/详细地址 (如：柏坡西路124号) -->
                <TextView
                    android:id="@+id/tv_location_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#888888"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 2.2 下半部分：地图静态缩略图 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="100dp">

                <ImageView
                    android:id="@+id/iv_map_snapshot"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:color/holo_blue_light" />

                <!-- 静态图正中间的定位大头针 -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_chat_location"
                    app:tint="#07C160" />
            </RelativeLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>