<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F7F7F7">

    <!-- 1. 顶部核心个人名片卡片 (白底) -->
<androidx.constraintlayout.widget.ConstraintLayout
android:id="@+id/layout_profile_header"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:background="#FFFFFF"
android:paddingStart="24dp"
android:paddingTop="48dp"
android:paddingEnd="24dp"
android:paddingBottom="40dp"
app:layout_constraintTop_toTopOf="parent">

<!-- 头像 (微信标准的 72dp 矩形微圆角) -->
<com.google.android.material.imageview.ShapeableImageView
    android:id="@+id/iv_profile_avatar"
    android:layout_width="72dp"
    android:layout_height="72dp"
    android:scaleType="centerCrop"
    android:src="@android:drawable/sym_def_app_icon"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent" />

<!-- 昵称 (22sp 黑色粗体) -->
<TextView
    android:id="@+id/tv_profile_nickname"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:ellipsize="end"
    android:maxLines="1"
    tools:text="null"
    android:textColor="#181818"
    android:textSize="22sp"
    android:textStyle="bold"
    app:layout_constraintStart_toEndOf="@id/iv_profile_avatar"
    app:layout_constraintTop_toTopOf="@id/iv_profile_avatar" />

<!-- 微信号文本 -->
<TextView
    android:id="@+id/tv_profile_wechat_id"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    tools:text="微信号：null"
    android:textColor="#7F7F7F"
    android:textSize="14sp"
    app:layout_constraintStart_toStartOf="@id/tv_profile_nickname"
    app:layout_constraintTop_toBottomOf="@id/tv_profile_nickname" />

<!-- 右侧卡片级超细跳转剪纸 > 箭头 -->
<ImageView
    android:layout_width="20dp"
    android:layout_height="20dp"
    android:src="@drawable/ic_chevron_right"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 名片底部底线 -->
<View
android:id="@+id/view_header_divider"
android:layout_width="match_parent"
android:layout_height="0.5dp"
android:background="#E5E5E5"
app:layout_constraintTop_toBottomOf="@id/layout_profile_header" />

<View
android:id="@+id/view_me_spacer"
android:layout_width="match_parent"
android:layout_height="8dp"
android:background="#F7F7F7"
app:layout_constraintTop_toBottomOf="@id/view_header_divider" />

    <!-- 2. 下方设置选项列表 (智能助手 + 设置，高度均为 56dp) -->
<LinearLayout
android:id="@+id/layout_me_options"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:background="#FFFFFF"
android:orientation="vertical"
app:layout_constraintTop_toBottomOf="@id/view_me_spacer">

<!-- 选项一：智能助手 -->
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/layout_ai_assistant"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <!-- 智能助手图标 -->
    <ImageView
        android:id="@+id/iv_icon_ai"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="24dp"
        android:src="@drawable/ic_me_ai"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="智能助手"
        android:textColor="#181818"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_icon_ai"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_chevron_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

<!-- 细分割线 (左侧缩进56dp，精准空出图标位置，对标微信) -->
<View
    android:layout_width="match_parent"
    android:layout_height="0.5dp"
    android:layout_marginStart="56dp"
    android:background="#E5E5E5" />

<!-- 选项二：设置 -->
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/layout_settings"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <!-- 设置图标 -->
    <ImageView
        android:id="@+id/iv_icon_settings"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="24dp"
        android:src="@drawable/ic_me_settings"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="退出登录"
        android:textColor="#181818"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_icon_settings"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_chevron_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>

    <!-- 设置选项底部的底部分割线 -->
<View
android:id="@+id/view_options_divider"
android:layout_width="match_parent"
android:layout_height="0.5dp"
android:background="#E5E5E5"
app:layout_constraintTop_toBottomOf="@id/layout_me_options" />

    </androidx.constraintlayout.widget.ConstraintLayout>