<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:padding="8dp">

    <!-- 1. 发送失败时的红色感叹号 (默认隐藏) -->
    <ImageView
        android:id="@+id/iv_send_failed"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="6dp"
        android:src="@android:drawable/stat_notify_error"
        android:visibility="gone"
        app:tint="#FA5151" />

    <!-- 2. 定位消息卡片 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_location_bubble"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 定位卡片主体内容 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 上半部分：主地名与详细地址 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_location_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="#111111"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_location_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:textColor="#888888"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 下半部分：地图静态缩略图 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp">

                    <ImageView
                        android:id="@+id/iv_map_snapshot"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#F2F2F2"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_chat_location"
                        app:tint="#07C160" />
                </RelativeLayout>
            </LinearLayout>

            <!-- 3. 发送中半透明黑色遮罩 (默认隐藏) -->
            <View
                android:id="@+id/view_upload_mask"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#40000000"
                android:visibility="gone" />

            <!-- 4. 发送中白色转圈圈 (默认隐藏) -->
            <ProgressBar
                android:id="@+id/progress_upload"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_centerInParent="true"
                android:indeterminateTint="#FFFFFF"
                android:visibility="gone" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. 我的头像 -->
    <ImageView
        android:id="@+id/iv_send_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/bg_icon_green_rounded" />

</LinearLayout>