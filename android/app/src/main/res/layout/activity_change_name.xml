<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F7F7F7"> <!-- 统一的 F7 浅灰背景 -->

    <!-- 1. 顶部扁平导航栏 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#F7F7F7"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 左侧返回 -->
        <LinearLayout
            android:id="@+id/btn_back_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            tools:ignore="MissingConstraints">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_back"
                app:tint="#1A1A1A" />
        </LinearLayout>

        <!-- 居中标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="更改名字"
            android:textColor="#181818"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 右侧：小药丸形状“保存”按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="60dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="保存"
            android:textColor="#B2B2B2"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#E1E1E1"
            app:cornerRadius="4dp"
            app:elevation="0dp"
            android:stateListAnimator="@null"
            android:enabled="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. 输入框 (应用我们写好的动态下划线背景) -->
    <EditText
        android:id="@+id/et_name_input"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_edit_text_selector"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:textColor="#181818"
        android:textSize="17sp"
        android:singleLine="true"
        android:maxLength="20"
        android:importantForAutofill="no"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- 3. 下方提示语 -->
    <TextView
        android:id="@+id/tv_change_name_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:text="好名字可以让你的朋友更容易记住你。"
        android:textColor="#9E9E9E"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/et_name_input" />

</androidx.constraintlayout.widget.ConstraintLayout>